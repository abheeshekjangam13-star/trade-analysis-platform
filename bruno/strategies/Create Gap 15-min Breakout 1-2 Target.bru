meta {
  name: Create Gap 15-min Breakout 1-2 Target
  type: http
  seq: 13
}

post {
  url: {{strategyUrl}}/api/strategies
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Nifty Gap-Day First 15-min Breakout - 1:2 target",
    "description": "Trades only when NIFTY opens >= 0.2% away from the previous close. Gap up: long (CE) only; gap down: short (PE) only. Reference = first 15-min candle 09:15-09:30 IST (high/low of the three 5-min candles). Entry on a fresh 5-min close above the 15-min high (gap up) or below the 15-min low (gap down). Initial SL = low (CE) / high (PE) of the 5-min breakout candle. Whole position exits at 1:2 risk-reward. Max 1 trade/day. EOD square-off 15:20. Backtest deducts Rs 85 charges per trade.",
    "type": "NIFTY_OPENING_BREAKOUT",
    "parameters": {
      "lots": "2",
      "directions": "WITH_GAP",
      "gapFilter": "ANY_GAP",
      "gapPct": "0.2",
      "referenceMinutes": "15",
      "initialStop": "BREAKOUT_CANDLE",
      "targetR": "2",
      "trailAfterR": "2",
      "maxTradesPerDay": "1",
      "trailMinutes": "5",
      "costPerTrade": "85"
    }
  }
}

vars:pre-request {
  strategyUrl: http://localhost:8080
}
