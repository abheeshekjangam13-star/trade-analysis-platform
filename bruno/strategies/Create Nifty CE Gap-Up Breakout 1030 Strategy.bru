meta {
  name: Create Nifty CE Gap-Up Breakout 1030 Strategy
  type: http
  seq: 8
}

post {
  url: {{strategyUrl}}/api/strategies
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Nifty CE Gap-Up Breakout with 120 Target 5 min close",
    "description": "Trades only when NIFTY opens >= 0.2% above the previous close. CE only, max 1 trade/day. Ref candle 09:15-09:20 IST; buy CE at ATM-50 on a fresh 5-min close above refHigh. Initial SL = (refHigh+refLow)/2; trail on completed 5-min close (max(SL, low)). Target +150 spot points. EOD square-off 15:20. Backtest deducts Rs 85 charges per trade.",
    "type": "NIFTY_OPENING_BREAKOUT",
    "parameters": {
      "lots": "2",
      "directions": "CE",
      "trailMinutes": "5",
      "gapPct": "0.2",
      "lotSize": "65",
      "costPerTrade": "85",
      "targetPoints": "120",
      "gapFilter": "GAP_UP",
      "maxTradesPerDay": "1"
    },
    "createdAt": "2026-11-04T05:07:43.120046Z"
  }
}

vars:pre-request {
  strategyUrl: http://localhost:8080
}
