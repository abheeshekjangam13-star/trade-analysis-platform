meta {
  name: Get Latest Candles
  type: http
  seq: 2
}

get {
  url: {{marketDataUrl}}/api/market-data/:symbol?interval=MINUTE_5&limit=100
  body: none
  auth: none
}

params:query {
  interval: MINUTE_5
  limit: 100
}

params:path {
  symbol: NIFTY 50
}

vars:pre-request {
  marketDataUrl: http://localhost:8080
}
