# Copy to .env on the VM (chmod 600 .env). Never commit the real .env.

# Your domain (DNS A record → the VM's static IP) and the email Let's Encrypt sends certificate notices to.
DOMAIN=trade.example.com
ACME_EMAIL=you@example.com

# Cloud SQL (private IP from: gcloud sql instances describe trade-db --format='value(ipAddresses[0].ipAddress)')
DB_HOST=10.x.x.x
DB_PORT=5432
DB_NAME=trade_analysis
DB_USER=trade
DB_PASSWORD=

# Login tokens: at least 32 characters (openssl rand -base64 48). Changing it logs everyone out.
AUTH_JWT_SECRET=
# Encrypts users' Kite secrets/tokens: base64 of 32 bytes (openssl rand -base64 32). Keep it forever.
KITE_ENCRYPTION_KEY=

# The platform Kite Connect app (market data). Its redirect URL must be https://<DOMAIN>/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Live orders stay off until you have registered this VM's static IP with Zerodha and tested in PAPER.
TRADING_LIVE_ENABLED=false
TRADING_RUNNER_ENABLED=true

# Optional: email (blank = emails are only logged) and Razorpay (blank = online payments off).
# Razorpay webhook URL: https://<DOMAIN>/api/payments/webhook
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
