# Copy to .env on the VM (chmod 600 .env). Never commit the real .env.

# Your domain (DNS A record → the VM's static IP) and the email Let's Encrypt sends certificate notices to.
DOMAIN=trade.example.com
ACME_EMAIL=you@example.com

# Cloud SQL (private IP from: gcloud sql instances describe trade-db --format='value(ipAddresses[0].ipAddress)')
DB_HOST=10.x.x.x
DB_PORT=5432
DB_NAME=trade_analysis
DB_USER=trade
DB_PASSWORD=

# Login tokens: at least 32 characters (openssl rand -base64 48). Changing it logs everyone out.
AUTH_JWT_SECRET=
# Encrypts users' Kite secrets/tokens: base64 of 32 bytes (openssl rand -base64 32). Keep it forever.
KITE_ENCRYPTION_KEY=

# The platform Kite Connect app (market data). Its redirect URL must be https://<DOMAIN>/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Live trading is switched on or off by an admin on the Trading page (off at first): register this VM's static IP
# with Zerodha and test in PAPER before turning it on.
TRADING_RUNNER_ENABLED=true

# Email: every message to users (sign-up, approval, payments, plan reminders, password changes) is sent by email.
# Blank MAIL_HOST = emails are only logged. GCP blocks port 25: use 587. Gmail needs an app password. See README §8.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Razorpay (blank = online payments off). Start with rzp_test_ keys, then switch to rzp_live_ (README §8).
# Webhook URL: https://<DOMAIN>/api/payments/webhook, events payment.captured, payment.failed, order.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
